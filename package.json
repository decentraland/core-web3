{
  "name": "@dcl/core-web3",
  "version": "0.1.0",
  "description": "Shared Web3 connectivity layer for Decentraland dApps",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "types": "./dist/esm/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "npm run build:esm && npm run build:cjs",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "lint:pkg": "npmPkgJsonLint .",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "test": "vitest",
    "test:run": "vitest run",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "peerDependencies": {
    "@dcl/schemas": "^20.3.1",
    "@tanstack/react-query": "^5.62.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "viem": "^2.21.0",
    "wagmi": "^2.14.0"
  },
  "devDependencies": {
    "@dcl/eslint-config": "^2.4.3",
    "@dcl/schemas": "^20.3.1",
    "@magic-ext/oauth2": "^14.0.0",
    "@tanstack/react-query": "^5.62.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-babel-module": "^5.3.2",
    "eslint-import-resolver-typescript": "^3.6.1",
    "eslint-plugin-autofix": "^1.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-react": "^7.34.1",
    "magic-sdk": "^32.0.0",
    "npm-package-json-lint": "^8.0.0",
    "prettier": "^3.4.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "typescript": "^5.7.0",
    "viem": "^2.21.0",
    "vitest": "^2.1.0",
    "wagmi": "^2.14.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/decentraland/core-web3.git"
  },
  "keywords": [
    "decentraland",
    "web3",
    "redux",
    "wallet"
  ],
  "author": "Decentraland",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/decentraland/core-web3/issues"
  },
  "homepage": "https://github.com/decentraland/core-web3#readme"
}
