{
  "name": "@dcl/core-web3",
  "version": "0.1.0",
  "description": "Shared Web3 connectivity layer for Decentraland dApps",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "types": "./dist/esm/index.d.ts"
    },
    "./lazy": {
      "import": "./dist/esm/lazy/index.js",
      "require": "./dist/cjs/lazy/index.js",
      "types": "./dist/esm/lazy/index.d.ts"
    },
    "./lazy/package.json": "./package.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "npm run build:esm && npm run build:cjs",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "lint:pkg": "npmPkgJsonLint .",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "peerDependencies": {
    "@dcl/crypto": "^3.4.5",
    "@dcl/schemas": "^26.1.0",
    "@dcl/single-sign-on-client": "^0.1.0",
    "@reduxjs/toolkit": "^2.5.0",
    "@tanstack/react-query": "^5.62.0",
    "magic-sdk": "^27.0.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-redux": "^9.2.0",
    "thirdweb": "^5.0.0",
    "viem": "^2.21.0",
    "wagmi": "^2.14.0"
  },
  "peerDependenciesMeta": {
    "@dcl/crypto": {
      "optional": true
    },
    "@dcl/single-sign-on-client": {
      "optional": true
    },
    "magic-sdk": {
      "optional": true
    }
  },
  "devDependencies": {
    "@dcl/crypto": "^3.4.5",
    "@dcl/eslint-config": "^3.0.0",
    "@dcl/schemas": "^26.1.0",
    "@dcl/single-sign-on-client": "^0.1.0",
    "@magic-ext/oauth2": "14.0.0",
    "@reduxjs/toolkit": "2.12.0",
    "@swc/core": "1.15.8",
    "@swc/jest": "0.2.39",
    "@tanstack/react-query": "5.62.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.1",
    "@types/jest": "30.0.0",
    "@types/react": "18.3.0",
    "@types/react-dom": "18.3.0",
    "@typescript-eslint/eslint-plugin": "8.52.0",
    "@typescript-eslint/parser": "8.52.0",
    "eslint": "9.39.2",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.4",
    "eslint-plugin-autofix": "2.2.0",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-prettier": "5.5.4",
    "eslint-plugin-react": "7.37.5",
    "jest": "30.2.0",
    "jest-environment-jsdom": "30.2.0",
    "jsdom": "27.4.0",
    "magic-sdk": "27.0.0",
    "npm-package-json-lint": "8.0.0",
    "prettier": "3.5.3",
    "react": "18.3.0",
    "react-dom": "18.3.0",
    "react-redux": "9.2.0",
    "thirdweb": "5.120.0",
    "typescript": "5.8.3",
    "viem": "2.21.0",
    "wagmi": "2.14.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/decentraland/core-web3.git"
  },
  "keywords": [
    "decentraland",
    "web3",
    "redux",
    "wallet"
  ],
  "author": "Decentraland",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/decentraland/core-web3/issues"
  },
  "homepage": "https://github.com/decentraland/core-web3#readme"
}
